# ---- Virginia configuration (copy to .env for local dev; set as Railway variables in prod) ----
# Port the server listens on (Railway injects PORT automatically)
PORT=3000
# Directory for the SQLite database and uploaded files. On Railway, mount a volume at /data.
DATA_DIR=./data
# Single-user login password for the web app (pick a long passphrase)
APP_PASSWORD=change-me
# Random 32+ char secret used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string
# Anthropic API key (console.anthropic.com) - used to extract action items from transcripts/photos
ANTHROPIC_API_KEY=
# Claude model used for extraction
ANTHROPIC_MODEL=claude-opus-5-5
# Secret path token for the MCP endpoint used by the "Virginia" Claude project: https://<host>/mcp/<MCP_TOKEN>
MCP_TOKEN=
# Set to "1" to disable the login requirement (local development only!)
DISABLE_AUTH=

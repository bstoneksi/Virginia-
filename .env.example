# ---- Virginia configuration (copy to .env for local dev; set as Railway variables in prod) ----
# Port the server listens on (Railway injects PORT automatically)
PORT=3000
# Directory for the SQLite database and uploaded files. On Railway, mount a volume at /data.
DATA_DIR=./data
# Single-user login password for the web app (pick a long passphrase)
APP_PASSWORD=change-me
# Random 32+ char secret used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string
# Anthropic API key (console.anthropic.com) - used to extract action items from transcripts/photos
ANTHROPIC_API_KEY=
# Claude model used for extraction
ANTHROPIC_MODEL=claude-opus-5-5
# Secret path token for the MCP endpoint used by the "Virginia" Claude project: https://<host>/mcp/<MCP_TOKEN>
MCP_TOKEN=
# Set to "1" to disable the login requirement (local development only!)
DISABLE_AUTH=

# ---- Daily 7 am brief (Briefs page + email; see docs/example-instance/EMAIL-ROUTINE.md) ----
# Set to 0 to turn the scheduled brief off (POST /api/briefs/daily/run and the MCP tool run_daily_brief still work)
BRIEF_ENABLED=1
# Local time the brief is generated: 24-hour HH:MM in America/Detroit
BRIEF_TIME=07:00
# Days it runs: Mon-Fri (default), "daily" for every day, or a list such as Mon,Wed,Fri
BRIEF_DAYS=Mon-Fri
# Optional comma list of sections to include, in order (default: all of them):
#   overdue,dueToday,dueWeek,highPriority,needsOwner,review,addedYesterday,digest
BRIEF_SECTIONS=
# all = everyone's items with owner initials (default); mine = only Brandon's own and unowned items, like the Today page
BRIEF_SCOPE=all
# Resend API key (resend.com, free tier) - leave empty to keep the brief in the app only (no email)
RESEND_API_KEY=
# Where the brief is emailed
BRIEF_EMAIL_TO=bstone@teamksi.com
# Sender. Resend's onboarding sender only delivers to the address the Resend account was signed up with;
# verify a domain in Resend (DNS records) to send from an address of your own.
BRIEF_EMAIL_FROM=Virginia <onboarding@resend.dev>

# Optional path to the assistant config (absolute, or relative to the repo root). Default: assistant.config.json;
# an assistant.config.local.json in the repo root takes precedence over both. See ONBOARDING.md.
ASSISTANT_CONFIG=
